#include <winuser.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/bytes.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bytes Team"
            VALUE "FileDescription", "Bytes - File Juggler & Cleaner"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Bytes"
            VALUE "LegalCopyright", "Copyright (c) Bytes Team"
            VALUE "OriginalFilename", "Bytes.exe"
            VALUE "ProductName", "Bytes - File Juggler & Cleaner"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
